rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAccountWriteUnlocked() {
      return isAuthenticated() &&
        !exists(/databases/$(database)/documents/withdrawalLocks/$(request.auth.uid));
    }

    function meetingPath(meetingId) {
      return /databases/$(database)/documents/meetings/$(meetingId);
    }

    function activeRoomMember(meetingId) {
      return isAuthenticated() && request.auth.uid in get(meetingPath(meetingId)).data.memberUids;
    }

    match /meetings/{meetingId} {
      allow get: if isAuthenticated() &&
        (resource == null || request.auth.uid in resource.data.memberUids);
      allow list: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow update: if isAccountWriteUnlocked() &&
        request.auth.uid in resource.data.memberUids &&
        resource.data.participantModelVersion == 2 && resource.data.status == 'active' &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'date', 'memo']) ||
          validPhotoVersionUpdate());

      function validPhotoVersionUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let cover = /databases/$(database)/documents/meetings/$(meetingId)/photos/cover;
        return changed.hasAny(['photoVersion']) && changed.hasOnly(['photoVersion']) &&
          request.resource.data.photoVersion is string &&
          getAfter(cover).data.version == request.resource.data.photoVersion;
      }

      match /photos/cover {
        allow get: if activeRoomMember(meetingId);
        allow create, update: if isAccountWriteUnlocked() && validCover();

        function validCover() {
          let before = get(meetingPath(meetingId)).data;
          let after = getAfter(meetingPath(meetingId)).data;
          let cover = request.resource.data;
          return request.auth.uid in before.memberUids && before.participantModelVersion == 2 &&
            before.status == 'active' && cover.keys().hasOnly(['version', 'bytes']) &&
            cover.version is string && cover.version.matches('[0-9a-f-]{36}') &&
            after.photoVersion == cover.version && before.get('photoVersion', null) != cover.version &&
            cover.bytes is bytes && cover.bytes.size() > 0 && cover.bytes.size() <= 204800;
        }
      }

      match /participants/{participantId} {
        allow read: if activeRoomMember(meetingId);
      }

      match /expenses/{expenseId} {
        allow read: if activeRoomMember(meetingId);
        allow update: if isAccountWriteUnlocked() && activeRoomMember(meetingId) &&
          get(meetingPath(meetingId)).data.participantModelVersion == 2 &&
          get(meetingPath(meetingId)).data.status == 'active' &&
          resource.data.createdBy ==
            get(/databases/$(database)/documents/meetings/$(meetingId)/participantLinks/$(request.auth.uid)).data.participantId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memo', 'category', 'updatedAt', 'revision']) &&
          request.resource.data.memo is string && request.resource.data.memo.size() <= 200 &&
          request.resource.data.category in ['식비', '카페', '숙소', '교통', '기타'] &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.revision is string && request.resource.data.revision.size() == 36 &&
          request.resource.data.revision != resource.data.revision;
      }

      match /settlements/final {
        allow get: if activeRoomMember(meetingId);
      }
    }
  }
}
